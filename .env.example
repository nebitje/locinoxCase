# Kopieer naar .env en vul de waarden in. Commit nooit het echte .env-bestand.

# Supabase (publieke waarden, veilig in de frontend dankzij Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Enkel voor het seedscript en de serverless functie. Nooit in de frontend gebruiken.
SUPABASE_SERVICE_ROLE_KEY=

# Testaccounts voor de seed (wachtwoorden niet in de code)
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
